rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return signedIn() && (
        userData().role == 'super_admin' ||
        request.auth.token.email in [
          'adhirajjain364@gmail.com',
          'mayankjaisw8673@gmail.com',
          'suhanimahajan2810@gmail.com',
          'majumdarpayal50@gmail.com',
          'reshob.rc12345@gmail.com'
        ]
      );
    }

    function isManager() {
      return signedIn() && (
        userData().role == 'manager' ||
        userData().role == 'admin' ||
        isSuperAdmin()
      );
    }

    function isAdminOrManager() {
      return isSuperAdmin() || isManager();
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || isAdminOrManager());
      allow update: if isSuperAdmin() ||
        (signedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'email'
          ]));
      allow delete: if isSuperAdmin();

      match /favorites/{productId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /addresses/{addressId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        (isAdminOrManager() || request.resource.data.creatorUid == request.auth.uid || request.resource.data.creatorId == request.auth.uid);
      allow update: if signedIn() && (
        isAdminOrManager() ||
        resource.data.creatorUid == request.auth.uid ||
        resource.data.creatorId == request.auth.uid
      );
      allow delete: if signedIn() &&
        (isAdminOrManager() || resource.data.creatorUid == request.auth.uid || resource.data.creatorId == request.auth.uid);

      match /reviews/{buyerId} {
        allow read: if signedIn();
        allow create, update: if signedIn() &&
          request.auth.uid == buyerId &&
          request.resource.data.buyerId == buyerId &&
          request.resource.data.productId == productId &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() >= 3 &&
          request.resource.data.comment.size() <= 1000;
        allow delete: if isSuperAdmin();
      }
    }

    match /orders/{orderId} {
      // Customer orders are created by the authenticated payment API (Admin SDK).
      // Super admins may create clearly marked operational/sample records.
      allow create: if isSuperAdmin() &&
        request.resource.data.payoutStatus == 'pending' &&
        request.resource.data.paymentStatus != 'paid';
      allow read: if signedIn() && (
        isAdminOrManager() ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid
      );
      allow update: if isSuperAdmin() ||
        (signedIn() &&
          resource.data.creatorId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt',
            'rejectionReason',
            'consignmentNumber',
            'carrierName',
            'payoutStatus'
          ]));
      allow delete: if isSuperAdmin();
    }

    match /paymentIntents/{intentId} {
      allow read, write: if false;
    }

    match /paymentReceipts/{paymentId} {
      allow read, write: if false;
    }

    match /support_tickets/{ticketId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() &&
        (isAdminOrManager() || resource.data.userId == request.auth.uid);
      allow update: if signedIn() &&
        (isAdminOrManager() || resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if signedIn() && (
          isAdminOrManager() ||
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid
        );
        allow create: if isAdminOrManager() ||
          (signedIn() && request.resource.data.senderId == request.auth.uid);
      }
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /creator_profiles/{creatorId} {
      allow read: if signedIn();
      allow write: if signedIn() &&
        (isAdminOrManager() || request.auth.uid == creatorId);
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdminOrManager();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        isAdminOrManager() ||
        resource.data.creatorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow create: if signedIn();
      allow update: if signedIn() && (
        resource.data.creatorUid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }
  }
}
